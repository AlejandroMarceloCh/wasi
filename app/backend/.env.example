# Copia este archivo a .env y rellena los valores reales.
# .env está en .gitignore — nunca subir al repo.

# Base de datos: por defecto SQLite local (cero setup).
# Para PostgreSQL: descomentar y ajustar.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/wasi

# JWT — OBLIGATORIO. Generar uno aleatorio (mín. 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin valor o con menos de 32 chars, el backend NO arranca (ver database.py).
JWT_SECRET=
JWT_ALGO=HS256
JWT_EXPIRE_DAYS=7

# Groq — narrativa LLM sobre SHAP (opcional).
# Sin esta key el endpoint /api/fairvalue/narrative devuelve 503 silenciosamente.
# Key gratis en groq.com (sin tarjeta, 14,400 req/día free).
GROQ_API_KEY=gsk_...
