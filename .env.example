# Copiar a app/backend/.env y completar antes de arrancar.
# JWT_SECRET es obligatorio y debe ser aleatorio (minimo 32 caracteres):
# python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=sqlite:///./wasi.db
JWT_SECRET=
JWT_ALGO=HS256
JWT_EXPIRE_DAYS=7
WASI_ENABLE_DEMO_SEED=0
WASI_SKIP_BULK_SEED=1
WASI_CORS_ORIGINS=http://localhost:5500
GROQ_API_KEY=
