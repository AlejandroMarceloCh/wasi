# Copiar a app/backend/.env y completar antes de arrancar.
# JWT_SECRET es obligatorio y debe ser aleatorio (minimo 32 caracteres):
# python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=sqlite:///./wasi.db
JWT_SECRET=
JWT_ALGO=HS256
# #18: expiración del JWT en días. El token vive en localStorage (XSS = robado
# hasta expirar). Más corto = menos ventana de exposición pero más re-login.
# 1 es el balance recomendado; subilo solo si necesitás sesiones más largas.
JWT_EXPIRE_DAYS=1
WASI_ENABLE_DEMO_SEED=0
WASI_SKIP_BULK_SEED=1
WASI_CORS_ORIGINS=http://localhost:5500
GROQ_API_KEY=
